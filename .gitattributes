# Normalize text files
* text=auto eol=lf

# Unity YAML: keep LF, opt into UnityYAMLMerge (configure once per dev machine)
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.controller text eol=lf
*.anim       text eol=lf
*.meta       text eol=lf
*.asmdef     text eol=lf

*.cs         text eol=lf diff=csharp
*.md         text eol=lf
*.json       text eol=lf
*.shader     text eol=lf
*.hlsl       text eol=lf

# Binary assets
*.png        binary
*.jpg        binary
*.psd        binary
*.tga        binary
*.exr        binary
*.fbx        binary
*.wav        binary
*.mp3        binary
*.ogg        binary
*.ttf        binary
*.otf        binary
*.apk        binary
*.aab        binary

# Large binaries: enable Git LFS if the repo grows past ~1 GB
# *.fbx filter=lfs diff=lfs merge=lfs -text
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
